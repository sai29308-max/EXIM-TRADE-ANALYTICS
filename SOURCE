        <!-- Responsive Video Loader Script -->
        <script>
          /* Loads background video on desktop/tablet; falls back to interactive 3D globe on mobile */
          (function () {
            var v = document.querySelector('.hero-video'), phone = window.matchMedia('(max-width: 767.98px)');
            var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            function pick() {
              if (phone.matches) { if (v.getAttribute('src')) v.pause(); return; }
              if (still) { v.poster = v.getAttribute('data-still'); return; }
              if (!v.getAttribute('src')) { v.poster = v.getAttribute('data-poster'); v.src = v.getAttribute('data-src'); }
              var p = v.play(); if (p) p.catch(function () {});
            }
            pick();
            if (phone.addEventListener) phone.addEventListener('change', pick); else phone.addListener(pick);
          })();
        </script>

